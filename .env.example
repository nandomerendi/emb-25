# All content in this project is synthetic. Demo never calls an external model.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=3.2
LLM_MAX_CONCURRENCY=4
# Optional rates in USD per million tokens. Empty means unknown, not zero.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# Optional single-user shared secret; use only localhost without this.
COPILOT_API_TOKEN=
# Optional local sentence-transformers model directory; no implicit downloads.
EMBEDDING_MODEL_PATH=
